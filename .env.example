# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model Configuration
DEEPSEEK_MODEL=deepseek-chat

# Agent Configuration
AGENT_NAME=PersonalAssistant
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.7

# Google Calendar (real API)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Desktop application type)
# 3. Download the JSON and save as credentials_calendar.json in project root
# No .env vars needed — the JSON file is used directly.
# The agent will auto-detect credentials_calendar.json and use real API.
# If the file is missing, it falls back to mock data.
